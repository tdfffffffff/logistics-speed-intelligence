# Copy to `.env` and fill in whichever keys you have.
# EVERY key is optional: any model without a key is reported as
# "not evaluated" and the rest of the comparison proceeds normally.
# With no keys at all, the notebook replays cached responses and still
# renders end to end.

# Google AI Studio - free tier, no card required
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq - free tier, no card required. One key unlocks three vendors'
# open-weight models (Meta Llama, Alibaba Qwen, DeepSeek).
#   https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI - note the free tier requires opting into having your prompts used
# for training, which is discussed in the notebook's privacy section as a
# reason an ops team handling 3PL contract data may not be able to use it.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# No key needed for qwen2.5-1.5b-local: it runs on-device via transformers.
